{
  "name": "taskmate-xinoff-win",
  "version": "1.0.0",
  "description": "TaskMate Xin off (Windows) — gửi mail local, đồng bộ API",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "kill-port": "npx --yes kill-port 5174",
    "dev": "npm run kill-port && concurrently -k -n vite,electron -c blue,green \"vite\" \"wait-on tcp:127.0.0.1:5174 && npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .",
    "build": "tsc -b && vite build",
    "start": "npm run build && cross-env electron .",
    "pack": "npm run build && electron-builder --win",
    "pack:portable": "npm run build && electron-builder --win portable",
    "pack:zip": "npm run build && electron-builder --win zip"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.cybertech.taskmate.xinoff.win",
    "productName": "TaskMate Xin off",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "main.cjs",
      "renderer/**/*",
      "desktop/**/*"
    ]
  }
}
