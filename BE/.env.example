PORT=6969
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=taskmate
JWT_SECRET=your-super-secret-key-change-in-production
NODE_ENV=development
# URL frontend (Vercel) — dùng cho CORS trên production
FRONTEND_URL=https://task-mate-nine-nu.vercel.app
# URL công khai của BE (Render) — avatar cũ dạng /avatars/... sẽ trả absolute URL
# Render tự set RENDER_EXTERNAL_URL; hoặc khai báo thủ công:
# PUBLIC_API_URL=https://taskmate-be.onrender.com
# Thêm nhiều origin (phân tách bằng dấu phẩy) nếu cần
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# Khóa mã hóa mật khẩu webmail (AES-256-GCM) — bắt buộc trên production để gửi SMTP
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_CREDENTIALS_KEY=
# Test SMTP local: SMTP_EMAIL=... SMTP_PASSWORD=... SMTP_TO=... npm run test:smtp
# SMTP timeout (ms) — tránh treo request trên Render
# SMTP_CONNECTION_TIMEOUT_MS=15000
# SMTP_SOCKET_TIMEOUT_MS=20000
# Chỉ bật khi mail server dùng cert tự ký: SMTP_TLS_REJECT_UNAUTHORIZED=false